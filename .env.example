KEY=your_bailian_api_key_here
SEEDREAM_KEY=your_volcengine_ark_api_key_here

# Optional Xiaoyou mobile App channel. Generate a long random token locally.
XIAOYOU_APP_ENABLED=false
# Legacy bearer token retained only for older installed clients.
XIAOYOU_APP_TOKEN=
# Token signing and email-code verification secret; use at least 32 random characters.
XIAOYOU_APP_AUTH_SECRET=
# Legacy owner/test password accounts retained only for deployment compatibility.
XIAOYOU_APP_OWNER_USERNAME=yoyo
XIAOYOU_APP_OWNER_PASSWORD_HASH=
XIAOYOU_APP_TEST_USERNAME=test
XIAOYOU_APP_TEST_PASSWORD_HASH=
# Passwordless email-login database and verification email. The DB stays under data/.
XIAOYOU_APP_ACCOUNT_DB_PATH=/app/data/app_channel/accounts.db
XIAOYOU_APP_SMTP_HOST=
XIAOYOU_APP_SMTP_PORT=465
XIAOYOU_APP_SMTP_USERNAME=
XIAOYOU_APP_SMTP_PASSWORD=
XIAOYOU_APP_SMTP_FROM=
XIAOYOU_APP_SMTP_SSL=true
# Development/tests only; never enable in production because it returns codes.
XIAOYOU_APP_EMAIL_DEBUG_CODE=false
XIAOYOU_APP_DEFAULT_PROACTIVE=false
XIAOYOU_APP_VOICE_ENABLED=true
XIAOYOU_APP_TEXT_VOICE_DECISION_ENABLED=true
# “我们今天”只整理当天真实聊天；确认前仅保存在关系展示库草稿中。
XIAOYOU_APP_JOURNAL_MODEL=qwen3.7-plus
XIAOYOU_APP_JOURNAL_TIMEOUT=45
# App TTS uses Volcengine Seed-TTS 2.0 Audio Generation HTTP. Prefer API Key.
XIAOYOU_APP_TTS_API_KEY=
XIAOYOU_APP_TTS_VOICE=ICL_uranus_zh_female_rouguhunshi_tob
# Server-side volume scaling: 100=2.0x, 0=default, -50=0.5x.
XIAOYOU_APP_TTS_LOUDNESS_RATE=100
# Legacy Volcengine speech-console credentials; leave empty with API Key auth.
XIAOYOU_APP_TTS_APP_ID=
XIAOYOU_APP_TTS_ACCESS_KEY=
XIAOYOU_VOICE_ROOM_ENABLED=true
XIAOYOU_VOICE_ROOM_APP_ID=
XIAOYOU_VOICE_ROOM_ACCESS_KEY=
XIAOYOU_VOICE_ROOM_MODEL=1.2.1.1
XIAOYOU_VOICE_ROOM_SPEAKER=zh_female_xiaohe_jupiter_bigtts
XIAOYOU_VOICE_ROOM_LOUDNESS_RATE=100
XIAOYOU_VOICE_ROOM_IDLE_TIMEOUT=300
XIAOYOU_VOICE_ROOM_CAPABILITIES_ENABLED=true
XIAOYOU_VOICE_CAPABILITY_MODEL=qwen3.7-plus
XIAOYOU_VOICE_CAPABILITY_MIN_CONFIDENCE=0.78
XIAOYOU_VOICE_CAPABILITY_TIMEOUT=25
XIAOYOU_VOICE_CAPABILITY_ENABLE_THINKING=false

# Optional vivo system push. Register package com.yoyo.xiaoyou in vivo's
# developer console. Keep the App Secret on the server only.
XIAOYOU_VIVO_PUSH_APP_ID=
XIAOYOU_VIVO_PUSH_APP_KEY=
XIAOYOU_VIVO_PUSH_APP_SECRET=

# Stable identity migration anchors (optional)
XIAOYOU_LEGACY_SESSION_IDS=
XIAOYOU_TARGET_WECHAT_ALIAS=
XIAOYOU_TARGET_REMARK_NAME=
XIAOYOU_TARGET_NICKNAME=
